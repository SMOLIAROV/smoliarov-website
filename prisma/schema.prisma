generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id        String   @id @default(cuid())
  name      String
  position  String?
  message   String   @db.Text
  avatar    String?
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}